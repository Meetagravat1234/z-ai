# ============================================================
# Hirebase — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# On Vercel, set these in: Project Settings → Environment Variables.
# ============================================================

# --- DATABASE_URL (required) ---
# This is the URL the RUNNING APP uses at runtime (transaction-mode pooler, port 6543)
# Supports many concurrent connections — perfect for serverless (Vercel)
# IMPORTANT: pgbouncer=true + prepared_statements=false are REQUIRED with Supabase pooler
DATABASE_URL="postgresql://postgres.cggjtjzshhwzbycobrud:Dadvameet%401234@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statements=false"

# --- DIRECT_URL (required for Vercel build) ---
# This is the URL Prisma uses during build to push the schema (session-mode pooler, port 5432)
# Only used for migrations — not at runtime
DIRECT_URL="postgresql://postgres.cggjtjzshhwzbycobrud:Dadvameet%401234@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- NEXTAUTH (required) ---
NEXTAUTH_SECRET="k7m2n8p4q9r3s6t1u5v0w2x8y4z1a6b3"
NEXTAUTH_URL="https://your-actual-vercel-url.vercel.app"

# --- OPTIONAL: Skip AI enrichment on Vercel (fits in 60s timeout) ---
SKIP_ENRICHMENT="true"

# --- OPTIONAL: Affiliate job APIs (more India jobs) ---
# Sign up at https://developer.adzuna.com/ (free, 1000 req/month)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Sign up at https://www.careerjet.com/partners/api/ (free)
CAREERJET_AFFILIATE_ID=""

# --- JOB ALERTS (email digest feature) ---
# Resend is the transactional email provider we use to send job alert emails.
# 1. Sign up at https://resend.com (free, 3000 emails/month)
# 2. Verify hirebase.in as a sending domain in Resend dashboard
#    (they'll show you 3 DNS records to add — SPF, DKIM, MX)
# 3. Generate an API key at https://resend.com/api-keys
RESEND_API_KEY=""

# The From address on alert emails. Must be on a domain you've verified
# with Resend. While you're waiting for domain verification, you can set
# this to "onboarding@resend.dev" to send from the shared sandbox
# (only delivers to your own Resend account email).
RESEND_FROM_EMAIL="alerts@hirebase.in"

# Public URL of your site — used in alert emails so links point back
# to the right domain (e.g. https://www.hirebase.in).
NEXT_PUBLIC_APP_URL="https://www.hirebase.in"

# Secret that protects the /api/alerts/send route from being triggered
# by randos. Generate one with: openssl rand -hex 32
# Used by the Vercel Cron OR cron-job.org via x-cron-secret header.
CRON_SECRET=""

# --- AI FALLBACK (optional but recommended for bulk fetch) ---
# These are FREE AI providers used as fallbacks when z-ai (the primary AI
# provider) is rate-limited. Without these, bulk-fetching more than 1-2 jobs
# at a time will fail with "All AI providers are rate limited".
#
# Provider priority: z-ai → OpenRouter → Groq → Gemini
# Set at least ONE of these to make bulk fetch reliable. Setting all 3 gives
# you near-zero rate limit failures.

# OpenRouter — free tier, 50+ models (meta-llama/llama-3.1-8b-instruct:free)
# 1. Go to https://openrouter.ai (sign up, free)
# 2. Keys → Create Key
# 3. Copy the key (starts with sk-or-...)
OPENROUTER_API_KEY=""

# Groq — free, fast, OpenAI-compatible API (30 req/min, 14400 req/day)
# 1. Sign up at https://console.groq.com (free, no credit card)
# 2. Go to API Keys → Create API Key
# 3. Copy the key (starts with gsk_...)
GROQ_API_KEY=""

# Google Gemini — free, generous tier (15 req/min, 1500 req/day)
# 1. Go to https://aistudio.google.com/app/apikey (sign in with Google)
# 2. Click "Create API key"
# 3. Copy the key (starts with AIza...)
GEMINI_API_KEY=""
