{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "buildCommand": "sed -i 's/provider  = \"sqlite\"/provider  = \"postgresql\"/' prisma/schema.prisma && prisma db push --accept-data-loss && next build",
  "functions": {
    "src/app/api/sync/parallel/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/sync/deep-crawl/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/sync/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/admin/fetch-job/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/upload/resume/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/resume-optimize/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/cover-letter/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/mock-interview/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/salary-predict/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/skill-gap/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/ats-score/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/ai/enrich-job/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/alerts/send/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/payment/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/bulk-fetch/process/route.ts": {
      "maxDuration": 50
    },
    "src/app/api/jobs/cleanup/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/sync/parallel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/alerts/send",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/jobs/cleanup",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/drip-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 2 * * 0"
    }
  ]
}